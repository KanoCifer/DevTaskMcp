# Copy this file to `.env` and fill in your real values.

DEVTASK_API_KEY=
# API base URL — change if you run backend locally.
DEVTASK_API_BASE=

# --- streamable-http deployment ---
# Bearer token MCP clients must send to call this server.
# If left empty, application-level auth is disabled.
MCP_AUTH_TOKEN=
# Listen address/port for the HTTP server (compose forwards 127.0.0.1:8003).
MCP_HOST=0.0.0.0
MCP_PORT=8003
